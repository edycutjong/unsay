# unsay — every variable the server actually reads. Copy to .env and fill in.
# Nothing here is required: with all five unset the server starts, warns on
# stderr about each default it fell back to, and runs the full demo.

# ── credentials ──────────────────────────────────────────────────────────────
# HMAC-SHA256 key that signs and verifies Bearer tokens (src/http.ts mintToken /
# verifyToken). Unset, the server uses DEV_TOKEN_SECRET and says so at startup.
#   npm run keygen
UNSAY_TOKEN_SECRET=

# HMAC-SHA256 key for POST /write. The clinician UI signs `timestamp + "." + body`
# with it. Unset, the server accepts the dev signing key and says so at startup.
UNSAY_WRITE_SECRET=

# Patients POST /write may publish for, comma-separated. There is no per-patient
# authorization, so no other patient can come into existence through a write.
UNSAY_PATIENTS=ray

# ── deployment identity ──────────────────────────────────────────────────────
# Public origin. Becomes the RFC 8707 resource indicator (`<url>/mcp`) that every
# token's `aud` must match, and the base of the RFC 9728 metadata document.
# Unset, it is http://127.0.0.1:<bound port>.
UNSAY_PUBLIC_URL=

# Issuer identifier advertised in `authorization_servers`. Unsay is a protected
# RESOURCE only — it serves no /authorize, /token or JWKS endpoint. Unset, the
# metadata names this origin, because in the default configuration this codebase
# is literally what mints the tokens.
UNSAY_AUTH_SERVER=

# ── at rest ──────────────────────────────────────────────────────────────────
# local | kms | none (default). Unset means PLAINTEXT at rest, which the startup
# banner and GET /verify both state out loud rather than implying encryption.
UNSAY_KEY_PROVIDER=

# Required when UNSAY_KEY_PROVIDER=local. 32 bytes, hex or base64.
#   npm run keygen
UNSAY_MASTER_KEY=

# Required when UNSAY_KEY_PROVIDER=kms. No AWS SDK is used; the KMS calls are
# SigV4-signed by hand over fetch. See FRICTION.md F-010: this path has never run
# against a live CMK.
AWS_REGION=
UNSAY_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional key id recorded in the envelope header for the local provider.
UNSAY_KEY_ID=

# ── audit ────────────────────────────────────────────────────────────────────
# JSONL file every write attempt is appended to, accepted or rejected. Unset, the
# log is in memory only and dies with the process.
UNSAY_AUDIT_LOG=

# ── entrypoint ───────────────────────────────────────────────────────────────
# Port and bind address for `npm start`. 39500 is what the pages in web/ default to.
PORT=39500
HOST=127.0.0.1
